# Local settings for docker compose. Don't copy this file by hand: run
#   .\scripts\init-env.ps1
# which writes .env (git-ignored) with a fresh random value for each EMPTY entry below, and copies
# the entries that have a value as they are. (Copied by hand, the empty entries would stop
# "docker compose up": compose refuses to start with an empty password.)
#
# LOCAL DEVELOPMENT ONLY. Never reuse these anywhere real.

POSTGRES_SUPERUSER_PASSWORD=
# Flyway migrations log in as erp_owner (owns the schema); the running API as erp_app
# (no DDL, insert-only on the stock ledger and invoices, read-only on stock balances).
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# The API's client secret for browser sign-in (client "erp-web", imported into the realm on Keycloak's first start)
KEYCLOAK_CLIENT_SECRET=
# Password of the demo users adam, pam, max, bea, walt, sue and finn (imported on Keycloak's first start)
DEMO_USER_PASSWORD=

# Not a secret: the company's time zone, which decides invoice dates and so their fiscal year.
ERP_TIME_ZONE=UTC
